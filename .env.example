# --- RAGbot configuration ---
# Copy to .env and adjust as needed.

# Ollama chat model (small, CPU-friendly)
RAGBOT_LLM_MODEL=qwen2.5:3b

# Local embedding model (Sentence Transformers)
RAGBOT_EMBED_MODEL=all-MiniLM-L6-v2

# Where the Chroma vector store is persisted
RAGBOT_CHROMA_PATH=./chroma_db

# Chroma collection name
RAGBOT_COLLECTION=my_docs

# Folder containing source documents to ingest
RAGBOT_DATA_DIR=./data

# Retrieval / chunking settings
RAGBOT_TOP_K=4
RAGBOT_CHUNK_SIZE=400
RAGBOT_CHUNK_OVERLAP=50
